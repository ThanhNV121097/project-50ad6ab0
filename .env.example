# Local PostgreSQL user for docker compose.
POSTGRES_USER=app

# Local PostgreSQL password for docker compose.
POSTGRES_PASSWORD=app_secret

# Local PostgreSQL database name for docker compose.
POSTGRES_DB=app

# Host port forwarded to backend container port 8080.
BACKEND_PORT=8080

# Host port forwarded to frontend container port 3000.
FRONTEND_PORT=3000

# Browser-visible backend base URL used by Next.js.
NEXT_PUBLIC_API_URL=http://localhost:8080
