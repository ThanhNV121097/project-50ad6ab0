# Local PostgreSQL user for docker compose local profile.
POSTGRES_USER=app

# Local PostgreSQL password for docker compose local profile.
POSTGRES_PASSWORD=app_secret

# Local PostgreSQL database for docker compose local profile.
POSTGRES_DB=app

# Host port mapped to backend service.
BACKEND_PORT=8080

# Host port mapped to frontend service.
FRONTEND_PORT=3000

# Browser-visible backend base URL baked into frontend build.
NEXT_PUBLIC_API_URL=http://localhost:8080
